      "AuthSessionResponse": {
        "description": "Bearer token plus user identity returned after register/login.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserResponse"
          }
        },
        "required": [
          "access_token",
          "user"
        ],
        "title": "AuthSessionResponse",
        "type": "object"
      },
      "AuthUserResponse": {
        "description": "Authenticated user identity returned to the frontend.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "role": {
            "enum": [
              "admin",
              "user"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "role"
        ],
        "title": "AuthUserResponse",
        "type": "object"
      },
      "BacktestJobStatusResponse": {

# Copy this file to deploy/env/platform.env and replace both placeholders locally.
# That local file is ignored by Git and must never be committed.
PLATFORM_ENV_FILE=./env/platform.env.example
POSTGRES_DB=ctp_research
POSTGRES_USER=ctp_research
POSTGRES_PASSWORD=<set-a-local-postgres-password>
PLATFORM_POSTGRES_DSN=postgresql://ctp_research:<set-the-same-local-postgres-password>@postgres:5432/ctp_research
PLATFORM_ROOT=/workspace
PLATFORM_PRIVATE_NETWORK_ONLY=true
